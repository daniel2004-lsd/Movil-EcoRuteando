{
  "expo": {
    "name": "EcoRuteando",
    "slug": "ecoruteando-mobile",
    "scheme": [
      "ecoruteando",
      "com.ecoruteando.mobile"
    ],
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#064e3b"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ecoruteando.mobile",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#e8f3ec"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${MAPS_API_KEY}"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#e8f3ec",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "EcoRuteando usa tus fotos para adjuntar imágenes a los reportes de obstáculos.",
          "cameraPermission": "EcoRuteando usa la cámara para que fotografíes los obstáculos que encuentres en la vía."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01c08b06-6601-4eff-bf51-5f2657fda9e7"
      }
    },
    "owner": "danielsalazarvargas95"
  }
}
