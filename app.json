{
  "expo": {
    "name": "EcoRuteando",
    "slug": "ecoruteando-mobile",
    "scheme": "ecoruteando",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ecoruteando.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#e8f3ec"
      },
      "config": {
        "googleMaps": {
          "apiKey": "${MAPS_API_KEY}"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#e8f3ec",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "EcoRuteando usa tus fotos para adjuntar imágenes a los reportes de obstáculos.",
          "cameraPermission": "EcoRuteando usa la cámara para que fotografíes los obstáculos que encuentres en la vía."
        }
      ]
    ]
  }
}
