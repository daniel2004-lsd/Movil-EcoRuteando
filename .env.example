# ==============================================================================
# EcoRuteando - Aplicación Móvil React Native / Expo (.env)
# Copiar este archivo a .env en la raíz del proyecto móvil y configurar los valores.
# NOTA: Este archivo .env NUNCA debe incluirse en Git (está en .gitignore).
# ==============================================================================

# URL base de la API del backend (ej. http://10.0.2.2:5124 para emulador Android o URL de producción)
EXPO_PUBLIC_API_URL=

# Google Maps Platform API Key (Clave específica para Móvil: EcoRuteando-Android)
# Requiere habilitar en Google Cloud Console: Maps SDK for Android, Places API, Directions API.
# Se recomienda restringir la clave por aplicación Android (Package name: com.ecoruteando.app y huella SHA-1).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
